# Ollama local LLM API (default port 11434 — separate from backend port 8000)
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=llama3

# ChromaDB vector store and PDF uploads (relative to backend/ when you run app.py)
CHROMA_PERSIST_DIR=./rag/vector_db
UPLOAD_DIR=./rag/uploaded_docs

# SQLite database
DATABASE_URL=sqlite+aiosqlite:///./database/tutor.db
